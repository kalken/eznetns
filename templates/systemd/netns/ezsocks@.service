[Unit]
Description=ezsocks %i
Requires=netns@%i.service
After=netns@%i.service

[Service]
#User=myuser
# Remove "--happy-eyeballs-impl builtin" if the async-stagger module is installed
ExecStart=/usr/bin/python3 /opt/ezsocks/prettysocks.py --listen-host 127.0.0.1 -p 1080 --log-level WARNING --happy-eyeballs-impl builtin

# namespace setup
NetworkNamespacePath=/run/netns/%i
BindReadOnlyPaths=/etc/eznetns/%i/resolv.conf:/etc/resolv.conf
BindReadOnlyPaths=/etc/eznetns/%i/nsswitch.conf:/etc/nsswitch.conf

[Install]
WantedBy=multi-user.target
