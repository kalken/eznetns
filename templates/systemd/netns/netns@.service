[Unit]
Description=netns setup
# wireguard endpoints may need dns and a route at boot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/eznetns %i setup
ExecStop=/usr/local/sbin/eznetns %i remove
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
