#!/usr/bin/env bash
set -e
shopt -s nullglob
if test "$EUID" -ne 0; then 
    echo "You need to have root privileges to run this script"
    exit 1
fi
netns.add () {
    ip netns add "$_ns"
    ip -n "$_ns" link set lo up
}
netns.nftables () {
    if test -f "$_nspath/nftables.conf"; then
        echo "nftables: $_nspath/nftables.conf"
        ip netns exec "$_ns" nft -f "$_nspath/nftables.conf"
    fi
}
netns.wireguard () {
    if test -d "$_nspath/wireguard"; then
        for _file in "$_nspath/wireguard/"*.conf; do
            _filename=$(basename -- "$_file")
            echo "wireguard: $_file"
            _dev="${_filename%.conf}"
            wg.up "$_dev"
        done
    fi
}
netns.remove () {
    # a process may exit between listing and killing
    ip netns pids "$_ns" | xargs -r kill 2>/dev/null || true
    ip netns del "$_ns"
}
wg.up () {
    local _dev="$1" _conf _addr _nameservers _mtu i
    # values can be split by comma, space or newline (repeated Address/DNS lines)
    local IFS=$', \n'
    if test -z "$_dev"; then
        echo "not enough information: \"dev\" argument is required."
        exit 1
    fi
    
    _conf="$_nspath/wireguard/$_dev.conf"
    if test ! -f "$_conf"; then
        echo "file not found: $_conf"
        exit 1
    fi
    ip link add "$_dev" type wireguard
    ip link set "$_dev" netns "$_ns"
    ip netns exec "$_ns" wg setconf "$_dev" <(wg-quick strip "$_conf")
    
    _addr=$(conf.value address "$_conf")
    for i in $_addr; do
        ip -n "$_ns" a add "$i" dev "$_dev"
    done
    
    _nameservers=$(conf.value dns "$_conf")
    if test ! -z "$_nameservers"; then
        echo "updating: $_nspath/resolv.conf"
        true > "$_nspath/resolv.conf"
        for i in $_nameservers; do
            echo "nameserver $i" >> "$_nspath/resolv.conf"
        done
    fi
    _mtu=$(conf.value mtu "$_conf")
    if test -n "$_mtu"; then
        ip -n "$_ns" link set "$_dev" mtu "$_mtu"
    fi
    ip -n "$_ns" link set "$_dev" up
    ip -n "$_ns" route add default dev "$_dev"
    ip -6 -n "$_ns" route add default dev "$_dev" || echo "warning: could not add ipv6 default route via $_dev"
}
wg.down () {
    local _dev="$1"
    
    if test -z "$_dev"; then
        echo "not enough information: \"dev\" argument is required."
        exit 1
    fi
    
    ip -n "$_ns" link del "$_dev"
}
conf.value () {
    # print the value of a wg-quick key (case insensitive), without trailing comments
    awk -F ' *= *' -v key="$1" 'tolower($1) ~ "^[ \t]*" key "$" {sub(/[ \t]*#.*/, "", $2); print $2}' "$2"
}
wg.reload () {
    wg.down "$1"
    wg.up "$1"
}
setup () {
    if test -e "/run/netns/$_ns"; then
        echo "$_ns already exists, reloading"
        reload
        return
    fi
    netns.add
    
    if test -d "$_nspath"; then
        netns.nftables
        netns.wireguard
    else
        echo "warning: $_nspath does not exist"
    fi
}
remove () {
    netns.remove
}
reload () {
    # Reload nftables firewall
    if test -f "$_nspath/nftables.conf"; then
        netns.nftables
    fi
    
    # Reload all wireguard interfaces
    if test -d "$_nspath/wireguard"; then
        for _file in "$_nspath/wireguard/"*.conf; do
            _filename=$(basename -- "$_file")
            _dev="${_filename%.conf}"
            
            # Check if the interface exists in the netns
            if ip -n "$_ns" link show "$_dev" &>/dev/null; then
                wg.reload "$_dev"
            else
                wg.up "$_dev"
            fi
        done
    fi
}
mounts () {
    test -f "$_nspath/resolv.conf" && echo -n "mount --bind $_nspath/resolv.conf /etc/resolv.conf;"
    test -f "$_nspath/nsswitch.conf" && echo -n "mount --bind $_nspath/nsswitch.conf /etc/nsswitch.conf;"
    test -d "/run/nscd" && echo -n "mount --bind /var/empty /run/nscd;"
}
execute () {
    nsenter --net=/var/run/netns/"$_ns" unshare --mount sh -c "$(mounts) exec \"\$@\"" sh "$@"
}
enter () {
    execute "$SHELL"
}
list () {
    ip netns list
    exit 0
}
help () {
    echo "Usage: eznetns [netns] [command]"
    echo "command: " $_commands
    echo "### eznetns uses files in /etc/eznetns/[netns] to setup network space. ###"
    exit 0
}
# main
_commands=$(compgen -A function)
case "${1-}" in 
 -h) help ;; 
 --help) help ;;
help) help ;;
list) list ;;
esac
_ns="${1-}"
if test -z "$_ns"; then
    help
fi
shift
if test -d "/etc/eznetns/$_ns"; then
  _nspath="/etc/eznetns/$_ns"
else
  _nspath="/etc/netns/$_ns"
fi
_command="${1-}"
if test -z "$_command"; then
    help
fi
shift
[[ $_commands =~ (^|[[:space:]])$_command($|[[:space:]]) ]] || { echo "command not found: $_command"; exit 1; }
$_command "$@"
