#!/usr/bin/env python3
import argparse
from pathlib import Path
import random
import os
import sys
import fnmatch
import zipfile


def info(message):
    # Status messages go to stderr, so --print output can be redirected to a file
    print(message, file=sys.stderr)


class Source:
    # The settings and templates, either a folder or a zip file with the same layout:
    # <netns>/<interface>.conf and <netns>/<interface>/<template>. A zip is read in
    # memory and never extracted, so the keys in it are not copied anywhere.
    def __init__(self, path):
        self.path = Path(path)
        self.archive = zipfile.ZipFile(self.path) if self.path.is_file() else None

    def names(self):
        if self.archive:
            return [n for n in self.archive.namelist() if not n.endswith('/')]
        return [str(p.relative_to(self.path)) for p in self.path.rglob('*') if p.is_file()]

    def has_dir(self, directory):
        prefix = f'{directory}/'
        return any(n.startswith(prefix) for n in self.names())

    def has_file(self, name):
        return name in self.names()

    def templates(self, directory, pattern):
        # Only files directly in the directory, like a glob would
        prefix = f'{directory}/' if directory else ''
        return [
            n for n in self.names()
            if n.startswith(prefix) and '/' not in n[len(prefix):]
            and fnmatch.fnmatch(n[len(prefix):], f'*{pattern}*')
        ]

    def read(self, name):
        if self.archive:
            return self.archive.read(name).decode()
        return (self.path / name).read_text()


def parse(text, origin):
    # WireGuard configs can repeat sections ([Peer]) and keys (AllowedIPs),
    # which configparser does not allow, so they are kept as ordered lists
    sections = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('[') and line.endswith(']'):
            sections.append((line[1:-1].strip(), []))
        elif '=' in line and sections:
            key, value = line.split('=', 1)
            sections[-1][1].append((key.strip(), value.strip()))
        else:
            raise ValueError(f'{origin}: can not parse line: {line}')
    return sections


def merge(template, settings):
    # A setting overrides the key in every template section with the same name,
    # e.g. a [Peer] setting applies to all peers. Sections missing in the template are added.
    for name, entries in settings:
        targets = [s for s in template if s[0].lower() == name.lower()]
        if not targets:
            template.append((name, list(entries)))
            continue
        for _, target in targets:
            keys = {k.lower() for k, _ in entries}
            target[:] = [(k, v) for k, v in target if k.lower() not in keys] + entries
    return template


def render(sections):
    return '\n'.join(
        f'[{name}]\n' + ''.join(f'{k} = {v}\n' for k, v in entries)
        for name, entries in sections
    )


def target_path(args):
    if args.netns:
        return Path(f'{args.target}/{args.netns}/wireguard/{args.interface}.conf')
    return Path(f'/etc/wireguard/{args.interface}.conf')


def write(target, content):
    if not target.parent.is_dir():
        info(f'creating: {target.parent}')
        target.parent.mkdir(parents=True, exist_ok=True)

    info(f'generating: {target}')
    # The config contains the private key, so only root may read it
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, 'w') as handle:
        handle.write(content)


def main(args):
    try:
        if not len(args.interface):
            sys.exit('please select device to configure with --dev')

        source = Source(args.source)
        prefix = f'{args.netns}/' if args.netns else ''
        template_dir = f'{prefix}{args.interface}'
        conf = f'{template_dir}.conf'
        if source.has_dir(template_dir):
            templates = source.templates(template_dir, args.pattern)
            if not templates:
                sys.exit(f'no templates matching "*{args.pattern}*" in {template_dir} in {args.source}')
        else:
            # Without the folder, the .conf files at the top are the templates, each a
            # complete config (a zip from a VPN provider, say), and there is no settings file
            templates = [n for n in source.templates('', args.pattern) if n.endswith('.conf')]
            conf = None
            if not templates:
                sys.exit(f'can not find directory {template_dir}, or any .conf files matching '
                         f'"*{args.pattern}*", in {args.source}')

        chosen = random.choice(templates)
        template = parse(source.read(chosen), chosen)

        # The settings file is optional: without it the template is used as is.
        # --settings names another one, kept outside the source, and is used instead
        if args.settings:
            merge(template, parse(Path(args.settings).read_text(), args.settings))
        elif conf and source.has_file(conf):
            merge(template, parse(source.read(conf), conf))
        elif conf:
            info(f'no settings file {conf}, using the template unchanged')

        target = target_path(args)
        if args.print:
            info(f'Printing what would be: {target}\n')
            sys.stdout.write(render(template))
        else:
            write(target, render(template))

    except Exception as e:
        sys.exit(e)


if __name__ == '__main__':
    my_parser = argparse.ArgumentParser(description='generate config for wireguard')
    my_parser.add_argument('--dev', dest='interface', type=str, default='', help='selected interface')
    my_parser.add_argument('--netns', dest='netns', type=str, default='', help='selected netns (optional)')
    my_parser.add_argument('--source', dest='source', type=str, default='/root/.config/ezwgen', help='choose source folder or zip file')
    my_parser.add_argument('--settings', dest='settings', type=str, default='', help='settings file to use instead of the one in the source (<netns>/<interface>.conf)')
    my_parser.add_argument('--target',dest='target', type=str, default='/etc/eznetns', help='choose target folder')
    
    my_parser.add_argument('--pattern', dest='pattern', type=str, default='.', help='file pattern')
    my_parser.add_argument('--print', dest='print', action='store_true', default=False,
                           help="print config but don't generate file")
    

    args = my_parser.parse_args()

    if os.geteuid() != 0:
        sys.exit("You need to have root privileges to run this script")

    main(args)
